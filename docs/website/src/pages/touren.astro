---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { tours } from '../data/touren';
import page from '../data/pages/touren.json';

// Bilder wie in der Galerie: aus src/assets/galerie, beim Build verkleinert.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/galerie/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}',
  { eager: true }
);

function findImage(path?: string): ImageMetadata | undefined {
  if (!path) return undefined;
  const name = path.split('/').pop();
  const key = Object.keys(files).find((k) => k.endsWith('/' + name));
  return key ? files[key].default : undefined;
}

const items = tours.map((t) => ({ ...t, img: findImage(t.image) }));

const facts = (t: (typeof items)[number]) =>
  [
    t.region,
    t.distanceKm ? `${t.distanceKm} km` : undefined,
    t.durationLabel,
    `${t.days} Tag${t.days === 1 ? '' : 'e'}`,
  ].filter(Boolean);

const steps = [
  { n: '1', title: 'Tour öffnen', text: '«Im Planer öffnen» lädt die Strecke mit allen Punkten, Fahrstilen und Tagen in den Routenplaner.' },
  { n: '2', title: 'Anpassen', text: 'Start verschieben, Zwischenziel einfügen, Übernachtung setzen – die Tour gehört jetzt dir.' },
  { n: '3', title: 'Mitnehmen', text: 'Als GPX fürs Navi exportieren oder unter «Meine Touren» speichern, auch offline.' },
];
---

<BaseLayout
  title="Touren"
  description="Tourenvorschläge der Pudgilly Riders: kurvige Strecken mit Pässen und Übernachtungen, direkt im Routenplaner zu öffnen."
>
  <PageHero eyebrow={page.hero.eyebrow} title={page.hero.title} text={page.hero.text} />

  <section class="section">
    <div class="container">
      {
        items.length === 0 ? (
          <p class="tours__empty">
            Die ersten Club-Touren sind in Arbeit. Bis dahin: eigene Tour im
            <a href="/planer/">Routenplaner</a> bauen.
          </p>
        ) : (
          <div class="tours">
            {items.map((t) => (
              <article class="tour" id={t.slug}>
                {t.img && (
                  <div class="tour__media">
                    <Image
                      src={t.img}
                      alt=""
                      widths={[480, 960]}
                      sizes="(max-width: 820px) 100vw, 50vw"
                      format="webp"
                      quality={76}
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="tour__body">
                  <div class="tour__head">
                    <h2 class="tour__title">
                      <a href={`#${t.slug}`}>{t.title}</a>
                    </h2>
                    {t.level && <span class:list={['level', `level--${t.level}`]}>{t.level}</span>}
                  </div>
                  <p class="tour__facts">{facts(t).join(' · ')}</p>
                  {t.stops.length > 0 && <p class="tour__route">{t.stops.join(' – ')}</p>}
                  {t.description && <p class="tour__desc">{t.description}</p>}
                  {t.highlights.length > 0 && (
                    <ul class="tour__tags">
                      {t.highlights.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  )}
                  {t.next && (
                    <p class="tour__next">
                      Nächste Ausfahrt: <a href="/events/">{t.next.dateLabel}</a>
                      {t.next.title !== t.title && ` – ${t.next.title}`}
                    </p>
                  )}
                  <div class="tour__actions">
                    <a href={t.plannerUrl} class="btn btn--primary">Im Planer öffnen →</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )
      }
      {page.note && <p class="tours__note">{page.note}</p>}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="text-center">
        <span class="eyebrow">So funktioniert's</span>
        <h2>Von der Idee aufs Navi</h2>
      </div>
      <div class="grid grid--3" style="margin-top: 2.5rem;">
        {
          steps.map((s) => (
            <article class="card">
              <div class="card__icon step__n">{s.n}</div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tours {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 820px) {
    .tours {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tour {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    /* Anker aus Events: unter der fixierten Kopfzeile landen */
    scroll-margin-top: 90px;
  }

  .tour__media img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .tour__body {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .tour__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .tour__title {
    margin: 0;
    font-size: 1.5rem;
  }

  .tour__title a {
    color: inherit;
  }

  .tour__title a:hover {
    color: var(--color-accent);
  }

  .level {
    flex-shrink: 0;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.22rem 0.65rem;
    border-radius: var(--pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .level--leicht {
    background: rgba(74, 222, 128, 0.14);
    color: #4ade80;
  }

  .level--anspruchsvoll {
    background: rgba(244, 114, 182, 0.14);
    color: #f472b6;
  }

  .tour__facts {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-accent);
  }

  .tour__route,
  .tour__desc,
  .tour__next {
    margin: 0;
    color: var(--color-text-muted);
  }

  .tour__route {
    font-size: 0.92rem;
  }

  .tour__desc {
    white-space: pre-line; /* Zeilenumbrüche aus dem CMS übernehmen */
  }

  .tour__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tour__tags li {
    font-size: 0.8rem;
    padding: 0.2rem 0.7rem;
    border-radius: var(--pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-border);
  }

  .tour__next a {
    color: var(--color-accent);
  }

  .tour__actions {
    margin-top: 0.5rem;
  }

  .tours__empty,
  .tours__note {
    color: var(--color-text-muted);
  }

  .tours__empty {
    margin: 0;
    padding: 1.75rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    text-align: center;
  }

  .tours__note {
    margin: 2rem 0 0;
    font-size: 0.9rem;
  }

  .step__n {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-accent);
  }
</style>
