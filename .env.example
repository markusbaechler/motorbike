# Build-time configuration (copy to .env.local for local builds; in CI set the
# values as repository variables).

# Booking.com affiliate id of the club. Optional: without it the hotel links
# work exactly the same, just without commission.
VITE_BOOKING_AID=

# Only for the OLD hosting (GitHub Pages) after the move: the planner's new
# address. The Home screen then shows a "moved" card whose link carries the
# saved tours along. Leave empty on the new hosting.
VITE_MOVED_TO=
