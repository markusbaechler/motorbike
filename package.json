{
  "name": "motorbike",
  "version": "0.1.0",
  "private": true,
  "description": "Motorrad-Routenplaner als PWA – kurvige Routen, Sehenswürdigkeiten, Übernachtungen via Booking.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:passopt": "node --loader ./scripts/ts-resolve.mjs scripts/test-passopt.mjs",
    "test:tourgen": "node --loader ./scripts/ts-resolve.mjs scripts/test-tourgen.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "maplibre-gl": "^4.7.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
