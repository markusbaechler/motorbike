---
import { statSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { nextEvent, furtherEvents, type ClubEvent } from '../data/events';
import { tourBySlug } from '../data/touren';
import page from '../data/pages/events.json';

const nextTour = tourBySlug(nextEvent?.tour);

// Weitere Termine nach Jahr gruppieren (z. B. Rest 2026, dann 2027)
const byYear = furtherEvents.reduce<Record<string, ClubEvent[]>>((acc, e) => {
  (acc[e.date.slice(0, 4)] ??= []).push(e);
  return acc;
}, {});
const years = Object.keys(byYear).sort();

// Jahresprogramm-PDF: Pfad und Texte kommen aus dem CMS («Seite · Events»),
// die Dateigrösse lesen wir beim Build direkt aus public/.
const program = page.program;
let programSize = '';
if (program?.file) {
  try {
    const bytes = statSync(new URL('../../public' + program.file, import.meta.url)).size;
    programSize = `${Math.round(bytes / 1024)} KB`;
  } catch {
    programSize = '';
  }
}

const badgeClass = (type: string) => ['badge', `badge--${type.toLowerCase()}`];
---

<BaseLayout title="Events" description="Termine der Pudgilly Riders: Ausfahrten, Treffen, Kurse und Feste im Clubjahr.">
  <h1 class="visually-hidden">{page.hero.title}</h1>

  <!-- Kopfbereich: der nächste Termin -->
  <section class="next" aria-labelledby="next-title">
    <div class="container next__inner">
      {
        nextEvent ? (
          <>
            <div class="next__text">
              <div class="next__kicker">
                <span class="eyebrow">{page.hero.eyebrow}</span>
                <span class="next__countdown">{nextEvent.relativeLabel}</span>
              </div>
              <h2 id="next-title" class="next__title">{nextEvent.title}</h2>
              <p class="next__when">
                <time datetime={nextEvent.date}>{nextEvent.longLabel}</time>
              </p>
              {nextEvent.location && (
                <p class="next__where">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  <span>{nextEvent.location}</span>
                </p>
              )}
              {nextEvent.description && <p class="next__desc">{nextEvent.description}</p>}
              {nextTour && (
                <a href={`/touren/#${nextTour.slug}`} class="btn btn--ghost next__tour">
                  Zur Tour: {nextTour.title} →
                </a>
              )}
            </div>

            <div class="cal-wrap" aria-hidden="true">
              <div class="cal">
                <div class="cal__month">{nextEvent.monthShort}</div>
                <div class="cal__day">{nextEvent.day}</div>
              </div>
              <span class:list={badgeClass(nextEvent.type)}>{nextEvent.type}</span>
            </div>
          </>
        ) : (
          <div class="next__text">
            <span class="eyebrow">{page.hero.eyebrow}</span>
            <h2 id="next-title" class="next__title">Noch nichts geplant</h2>
            <p class="next__desc">
              Aktuell sind keine kommenden Termine eingetragen. Neue Ausfahrten kündigen wir hier und per
              WhatsApp an.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- Alle weiteren Termine -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{page.listHeading}</h2>
          <p class="section-head__note">{page.note}</p>
        </div>
        {
          program?.file && (
            <div class="program">
              <a href={program.file} class="btn btn--ghost" download>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12" />
                  <path d="m7 10 5 5 5-5" />
                  <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
                </svg>
                {program.heading} als PDF
              </a>
              {programSize && <p class="program__meta">PDF, {programSize}</p>}
            </div>
          )
        }
      </div>

      {
        years.length === 0 ? (
          <p class="agenda__empty">Weitere Termine folgen, sobald sie feststehen.</p>
        ) : (
          years.map((year) => (
            <div class="year">
              <h3 class="year__label">{year}</h3>
              <ol class="agenda">
                {byYear[year].map((event) => (
                  <li class="agenda__row">
                    <time class="agenda__date" datetime={event.date}>
                      {event.shortLabel}
                    </time>
                    <div class="agenda__body">
                      <span class="agenda__title">{event.title}</span>
                      {(event.location || event.description) && (
                        <span class="agenda__meta">
                          {event.location}
                          {event.location && event.description && ' – '}
                          {event.description}
                        </span>
                      )}
                      {tourBySlug(event.tour) && (
                        <a class="agenda__tour" href={`/touren/#${tourBySlug(event.tour)!.slug}`}>
                          Tour ansehen →
                        </a>
                      )}
                    </div>
                    <span class:list={badgeClass(event.type)}>{event.type}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))
        )
      }

      <div class="text-center" style="margin-top: 3.5rem;">
        <a href={page.ctaButtonHref} class="btn btn--primary">{page.ctaButtonLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Kopfbereich: nächster Termin ---------- */
  .next {
    position: relative;
    overflow: hidden;
    background: #100f12 url('/hero/hero.jpg') center / cover no-repeat;
    border-bottom: 1px solid var(--color-border);
  }

  .next::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(16, 15, 18, 0.96) 0%, rgba(16, 15, 18, 0.86) 50%, rgba(16, 15, 18, 0.6) 100%),
      linear-gradient(180deg, rgba(16, 15, 18, 0.35) 0%, rgba(16, 15, 18, 0.92) 100%);
  }

  .next__inner {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  @media (min-width: 820px) {
    .next__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4rem;
    }
  }

  .next__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .next__kicker .eyebrow {
    margin: 0;
  }

  .next__countdown {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .next__title {
    /* Auf dem Handy etwas kleiner, damit lange Wörter wie «Generalversammlung» nicht überlaufen */
    font-size: clamp(2rem, 7vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    text-wrap: balance;
    overflow-wrap: anywhere;
    hyphens: auto;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }

  .next__when {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    margin: 0 0 0.5rem;
  }

  .next__where {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .next__where svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .next__desc {
    color: var(--color-text-muted);
    max-width: 55ch;
    margin: 0;
    font-size: 1.1rem;
    white-space: pre-line; /* Zeilenumbrüche aus dem CMS übernehmen */
  }

  .next__tour {
    margin-top: 1.25rem;
  }

  /* Kalender-Kachel */
  .cal-wrap {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .cal {
    position: relative;
    width: clamp(170px, 24vw, 230px);
    aspect-ratio: 1;
    border-radius: 30px;
    background: var(--brand-grad);
    box-shadow:
      var(--brand-glow),
      0 40px 90px rgba(240, 90, 40, 0.28);
    color: #fff;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  /* Die zwei Ringe eines Wandkalenders */
  .cal::before,
  .cal::after {
    content: '';
    position: absolute;
    top: -10px;
    width: 12px;
    height: 28px;
    border-radius: 6px;
    background: #f6f5f3;
    box-shadow: inset 0 -4px 0 rgba(0, 0, 0, 0.18);
  }

  .cal::before {
    left: 24%;
  }

  .cal::after {
    right: 24%;
  }

  .cal__month {
    border-radius: 30px 30px 0 0;
    background: rgba(16, 15, 18, 0.3);
    text-align: center;
    padding: 1rem 0 0.7rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-indent: 0.3em;
  }

  .cal__day {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5rem, 9vw, 7rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cal {
      animation: cal-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    @keyframes cal-in {
      from {
        opacity: 0;
        transform: translateY(18px) scale(0.96) rotate(-2deg);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* ---------- Liste der weiteren Termine ---------- */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .section-head h2 {
    margin-bottom: 0.35rem;
  }

  .section-head__note {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  .program {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }

  @media (min-width: 760px) {
    .program {
      justify-items: end;
    }
  }

  .program .btn svg {
    width: 18px;
    height: 18px;
  }

  .program__meta {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .year {
    display: grid;
    gap: 0.5rem 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 900px) {
    .year {
      grid-template-columns: 80px minmax(0, 1fr);
    }
  }

  .year__label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--color-text-muted);
    opacity: 0.55;
    margin: 0.9rem 0 0;
  }

  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .agenda__row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    gap: 0.3rem 1.5rem;
    align-items: center;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .agenda__row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .agenda__date {
    font-family: var(--font-display);
    font-weight: 600;
    white-space: nowrap;
  }

  .agenda__title {
    display: block;
    font-weight: 700;
  }

  .agenda__meta {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    white-space: pre-line; /* Zeilenumbrüche aus dem CMS übernehmen */
  }

  .agenda__tour {
    display: inline-block;
    margin-top: 0.3rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .agenda__empty {
    margin-top: 2.5rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 639px) {
    .agenda__row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .agenda__date {
      grid-column: 1 / -1;
      font-size: 0.85rem;
      color: var(--color-accent);
    }
  }

  /* Art des Termins */
  .badge {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    padding: 0.22rem 0.65rem;
    border-radius: var(--pill);
    white-space: nowrap;
  }

  .badge--treffen {
    background: rgba(96, 165, 250, 0.14);
    color: #60a5fa;
  }

  .badge--fest {
    background: rgba(244, 114, 182, 0.14);
    color: #f472b6;
  }

  .badge--kurs {
    background: rgba(74, 222, 128, 0.14);
    color: #4ade80;
  }
</style>
